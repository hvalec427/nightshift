#!/usr/bin/env bash
# A fake claude for the tests. `--version`, `auth status` and `plugin …`
# answer from $CLAUDE_FAKE; anything else is a run: it's numbered, its
# arguments (NUL-separated), directory and environment are kept in
# $CLAUDE_FAKE/runs/<k>/, and it prints stream-json while it plays the script
# in $CLAUDE_FAKE/script (shell, with the steps below; none: it just ends).
set -u
: "${CLAUDE_FAKE:?}"
# GitHub's files, which a script changes the way a run's gh would (gh_state).
# shellcheck source=github.sh
. "$(dirname "$0")/github.sh"
echo "$*" | tr '\n' ' ' >>"$CLAUDE_FAKE/calls"
echo >>"$CLAUDE_FAKE/calls"

case "${1:-}" in
--version) echo "${FAKE_CLAUDE_VERSION:-2.1.300} (Claude Code)"; exit 0 ;;
auth) printf '{\n  "loggedIn": %s\n}\n' "$([ -f "$CLAUDE_FAKE/logged-out" ] && echo false || echo true)"; exit 0 ;;
plugin)
  case "$*" in
  "plugin list --json") cat "$CLAUDE_FAKE/plugins.json" 2>/dev/null || echo '[]' ;;
  "plugin marketplace list --json") cat "$CLAUDE_FAKE/marketplaces.json" 2>/dev/null || echo '[]' ;;
  "plugin marketplace "* | "plugin install "* | "plugin update "* | "plugin enable "*) ;;
  *) echo "fake claude: unexpected: $*" >&2; exit 2 ;;
  esac
  exit 0 ;;
esac

mkdir -p "$CLAUDE_FAKE/runs"
k=1
until mkdir "$CLAUDE_FAKE/runs/$k" 2>/dev/null; do k=$((k + 1)); done
RUN="$CLAUDE_FAKE/runs/$k"
printf '%s\0' "$@" >"$RUN/args"
pwd -P >"$RUN/cwd"
env | grep -E '^(NIGHTSHIFT_|CLAUDE_CODE_OAUTH_TOKEN=)' | sort >"$RUN/env"

session="session-$k"
prev=""
for a in "$@"; do
  [ "$prev" = --resume ] && session=$a
  prev=$a
done

# One stream-json event.
event() { printf '%s\n' "$1"; }
tool_use() {
  jq -cn --arg c "$1" '{type: "assistant", message: {content: [{type: "tool_use", name: "Bash", input: {command: $c}}]}}'
}

# The steps a script plays.
# The agent's text.
say() { jq -cn --arg t "$1" '{type: "assistant", message: {content: [{type: "text", text: $t}]}}'; }
# A comment on the issue at stage $1 (text $2), posted with gh.
comment() {
  local body
  body="🤖 **nightshift** · $1

${2:-Some $1.}

<!-- nightshift --> <!-- nightshift:$1 -->"
  tool_use "gh issue comment $NIGHTSHIFT_ISSUE --body \"$body\""
  gh issue comment "$NIGHTSHIFT_ISSUE" --repo "$NIGHTSHIFT_REPO" --body "$body" >/dev/null
}
# The skill $1 invoked (`nightshift:plan`, …), as the Skill tool does; a
# subagent's if there's a 2nd (its Agent tool call's id).
skill() {
  jq -cn --arg s "$1" --arg p "${2:-}" \
    '{type: "assistant", parent_tool_use_id: (if $p == "" then null else $p end),
      message: {content: [{type: "tool_use", name: "Skill", input: {skill: $s}}]}}'
}
# A subagent of type $2 (`nightshift:ticket`, …) started for $3, its Agent tool
# call's id $1; named $4 (the Task tool's name in older claudes) if given.
agent() {
  jq -cn --arg i "$1" --arg t "$2" --arg d "$3" --arg n "${4:-Agent}" \
    '{type: "assistant", parent_tool_use_id: null,
      message: {content: [{type: "tool_use", id: $i, name: $n, input: {subagent_type: $t, description: $d, prompt: "…"}}]}}'
}
# The result of Agent call $1: its model $2, tokens $3, milliseconds $4 and tool calls $5.
agent_result() {
  jq -cn --arg i "$1" --arg m "$2" --argjson t "$3" --argjson d "$4" --argjson u "$5" \
    '{type: "user", parent_tool_use_id: null,
      message: {content: [{type: "tool_result", tool_use_id: $i, content: "done"}]},
      tool_use_result: {status: "completed", resolvedModel: $m, totalTokens: $t, totalDurationMs: $d, totalToolUseCount: $u}}'
}
# The status label $1, through nightshift.
label() { tool_use "nightshift label $1"; nightshift label "$1"; }
# A commit of file $1 (with content $2) on the issue's branch.
commit() {
  printf '%s\n' "${2:-$1}" >"$1"
  git add "$1" && git commit -q -m "feat: $1"
}
# The branch pushed and a pull request for it opened (its URL in $RUN/pr).
open_pr() {
  git push -q origin HEAD
  gh pr create --repo "$NIGHTSHIFT_REPO" --head "nightshift/issue-$NIGHTSHIFT_ISSUE" --base master \
    --title "feat: issue $NIGHTSHIFT_ISSUE" --body "${1:-Closes #$NIGHTSHIFT_ISSUE}" >"$RUN/pr"
}
# The run's pull request merged and its issue closed, as the merge skill's
# `gh pr merge` does (the fake gh has no `pr merge`).
merge_pr() {
  tool_use "gh pr merge $(cat "$RUN/pr")"
  gh_pr_set "$NIGHTSHIFT_REPO" "$(sed 's|.*/||' "$RUN/pr")" state '"MERGED"'
  gh_state "$NIGHTSHIFT_REPO" "$NIGHTSHIFT_ISSUE" closed
}
# What the run cost: dollars $1, and of model $2 tokens in $3, out $4, cache
# read $5 and cache written $6 (again for another model: added). The result
# gives the session's totals, as claude's does: a resumed run's include the
# runs before it.
result_extra={}
costs() {
  result_extra=$(jq -cn --argjson x "$result_extra" --argjson usd "$1" --arg m "$2" --argjson i "$3" --argjson o "$4" --argjson r "$5" --argjson w "$6" \
    '$x | .total_cost_usd = (.total_cost_usd // 0) + $usd
      | .modelUsage[$m] = {inputTokens: $i, outputTokens: $o, cacheReadInputTokens: $r, cacheCreationInputTokens: $w, costUSD: $usd}')
}
# Model $1's context window: $2 tokens.
window() {
  result_extra=$(jq -cn --argjson x "$result_extra" --arg m "$1" --argjson n "$2" '$x | .modelUsage[$m].contextWindow = $n')
}
# A turn of model $1, with $2 tokens in, $3 cache read and $4 cache written;
# a subagent's if there's a 5th (its Agent tool call's id).
turn() {
  jq -cn --arg m "$1" --argjson i "$2" --argjson r "$3" --argjson w "$4" --arg p "${5:-}" \
    '{type: "assistant", parent_tool_use_id: (if $p == "" then null else $p end),
      message: {model: $m, content: [{type: "text", text: "…"}], usage: {input_tokens: $i, cache_read_input_tokens: $r, cache_creation_input_tokens: $w, output_tokens: 1}}}'
}
# The session's totals so far forgotten: the result gives this run's alone,
# lower than the last one's.
forget() { rm -f "$CLAUDE_FAKE/sessions/$session"; }
# The run's result is an error.
error=false
fail_result() { error=true; }
# Wait until stopped (TERM): $RUN/waiting says it's waiting. Ends too if
# nightshift's run (its parent) is gone.
hang() {
  trap 'touch "$RUN/stopped"; exit 143' TERM
  touch "$RUN/waiting"
  while kill -0 "$PPID" 2>/dev/null; do sleep 0.2; done
}
# hang, but once stopped it lingers until $RUN/go exists, the way claude
# finishes its SessionEnd hooks.
linger() {
  trap 'touch "$RUN/stopped"; while [ ! -e "$RUN/go" ]; do sleep 0.1; done; exit 143' TERM
  touch "$RUN/waiting"
  while kill -0 "$PPID" 2>/dev/null; do sleep 0.2; done
}
# Wait until $RUN/go exists (or nightshift's run is gone), then go on:
# $RUN/waiting says it's waiting.
hold() {
  touch "$RUN/waiting"
  while [ ! -e "$RUN/go" ] && kill -0 "$PPID" 2>/dev/null; do sleep 0.1; done
}

# $CLAUDE_FAKE/silent: it fails before printing an event.
[ -e "$CLAUDE_FAKE/silent" ] && exit 1
event "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"$session\"}"
code=0
# shellcheck disable=SC1091
[ -f "$CLAUDE_FAKE/script" ] && . "$CLAUDE_FAKE/script"
mkdir -p "$CLAUDE_FAKE/sessions"
result_extra=$(jq -cn --argjson x "$result_extra" --argjson s "$(cat "$CLAUDE_FAKE/sessions/$session" 2>/dev/null || echo '{}')" '
  if $x == {} then $s else
    ($s.modelUsage // {}) as $was
    | $x | .total_cost_usd += ($s.total_cost_usd // 0)
    | .modelUsage |= with_entries(.key as $m | .value |= (($was[$m] // {}) + with_entries(if .key == "contextWindow" then . else .value += ($was[$m][.key] // 0) end)))
    | .modelUsage = $was + .modelUsage
  end')
printf '%s\n' "$result_extra" >"$CLAUDE_FAKE/sessions/$session"
event "$(jq -cn --argjson x "$result_extra" --argjson e "$error" --arg s "$session" \
  '{type: "result", subtype: "success", is_error: $e, result: "done", session_id: $s} + $x')"
exit "$code"
