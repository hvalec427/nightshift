#!/usr/bin/env bash
# A fake gh for the tests: the commands nightshift (and a fake run) use,
# against GitHub as files in $GH_FAKE (see github.sh). Every call is logged to
# $GH_FAKE/calls, a line each; one matching a pattern in $GH_FAKE/fail fails;
# one it doesn't know is logged to $GH_FAKE/unexpected and fails, so a test
# can't pass on an answer nobody gave.
set -u
: "${GH_FAKE:?}"
# shellcheck source=github.sh
. "$(dirname "$0")/github.sh"

call="$*"
printf '%s\n' "$call" | tr '\n' ' ' | sed 's/ $//' >>"$GH_FAKE/calls"
echo >>"$GH_FAKE/calls"
if [ -f "$GH_FAKE/fail" ]; then
  while IFS= read -r p; do
    # shellcheck disable=SC2053 # a glob, on purpose
    [ -n "$p" ] && [[ "$call" == $p ]] && { echo "fake gh: failing, as told: $call" >&2; exit 1; }
  done <"$GH_FAKE/fail"
fi

unexpected() {
  printf '%s\n' "$call" >>"$GH_FAKE/unexpected"
  echo "fake gh: unexpected call: $call" >&2
  exit 2
}
not_found() { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }

# The options every command here takes: --jq/-q, --json, --repo, -i, -H, and
# the rest as name/value pairs, positionals in POS.
jqf="" repo="" inc="" hdr="" POS=() OPTS=()
while [ $# -gt 0 ]; do
  case "$1" in
  -q | --jq) jqf=$2; shift ;;
  -i | --include) inc=1 ;;
  -H | --header) hdr=$2; shift ;;
  -R | --repo) repo=$2; shift ;;
  --json | -X | --method | --state | --limit | --head | --base | --title | --body | --body-file | \
    --add-label | --remove-label | --color | --description | -F | -f) OPTS+=("$1" "$2"); shift ;;
  --paginate | --force | --version | --active) OPTS+=("$1" "") ;;
  -*) unexpected ;;
  *) POS+=("$1") ;;
  esac
  shift
done
# An option's value (empty if not given).
opt() {
  local i
  for ((i = 0; i < ${#OPTS[@]}; i += 2)); do
    [ "${OPTS[i]}" = "$1" ] && { printf '%s' "${OPTS[i + 1]}"; return 0; }
  done
  return 1
}

# JSON on stdin, as gh prints it: through --jq when given (strings raw, null
# as an empty line), else as it is.
out() {
  if [ -n "$jqf" ]; then jq -r -c "($jqf) | if . == null then \"\" else . end"
  else cat
  fi
}

# JSON on stdin as an answer that has an ETag (a hash of it): with -i, the
# headers before it; asked If-None-Match that ETag, a 304 with no body, which
# gh fails on, as GitHub's does.
etagged() {
  local body tag
  body=$(cat)
  tag="W/\"$(printf '%s' "$body" | cksum | cut -d' ' -f1)\""
  if [ "$hdr" = "If-None-Match: $tag" ]; then
    [ -n "$inc" ] && printf 'HTTP/2.0 304 Not Modified\nEtag: %s\r\n\r\n' "$tag"
    exit 1
  fi
  [ -n "$hdr" ] && case "$hdr" in "If-None-Match: "*) ;; *) unexpected ;; esac
  [ -n "$inc" ] && printf 'HTTP/2.0 200 OK\nEtag: %s\r\n\r\n' "$tag"
  printf '%s\n' "$body" | out
}

# The value of GraphQL variable $1, given as -f/-F $1=value (empty if not given).
gql_var() {
  local i
  for ((i = 0; i < ${#OPTS[@]}; i += 2)); do
    case "${OPTS[i]}" in -f | -F) [ "${OPTS[i + 1]%%=*}" = "$1" ] && { printf '%s' "${OPTS[i + 1]#*=}"; return 0; } ;; esac
  done
  return 1
}

# `gh api graphql`: nightshift's named operations (the query's `query Name` or
# `mutation Name`), answered from the projects in $GH_FAKE (see github.sh). One
# it doesn't know, or called without the variables it takes, is unexpected.
graphql() {
  local op p
  op=$(gql_var query | sed -n -E 's/^[[:space:]]*(query|mutation)[[:space:]]+([A-Za-z]+).*/\2/p' | head -1)
  case "$op" in
  NightshiftBoard)
    p="$(gql_var owner)/$(gql_var number)"
    case "$p" in /* | */) unexpected ;; esac
    [ -f "$(gh_project_dir "$p")/project.json" ] ||
      { echo "gh: Could not resolve to a ProjectV2 with the number ${p#*/}. (repositoryOwner.projectV2)" >&2; exit 1; }
    board_page "$p" | out ;;
  NightshiftConvertDraft)
    # The draft card is found in whichever project has it, the repo by its node id.
    local item rid f r
    item=$(gql_var item) rid=$(gql_var repo) r=""
    for f in "$GH_FAKE"/repos/*/repo.json; do
      [ -f "$f" ] && [ "$(jq -r .node_id "$f")" = "$rid" ] && r=$(jq -r .full_name "$f")
    done
    [ -n "$r" ] || { echo "gh: Could not resolve to a Repository with the id $rid. (repositoryId)" >&2; exit 1; }
    for f in "$GH_FAKE"/projects/*/items.json; do
      [ -f "$f" ] && jq -e --arg i "$item" 'any(.[]; .id == $i and .draft)' "$f" >/dev/null || continue
      p=$(basename "$(dirname "$f")")
      gh_draft_convert "${p%_*}/${p##*_}" "$item" "$r" >/dev/null || exit 1
      jq -n -c --arg i "$item" '{data: {convertProjectV2DraftIssueItemToIssue: {item: {id: $i}}}}' | out
      return
    done
    echo "gh: Could not resolve to a DraftIssue item with the id $item. (itemId)" >&2; exit 1 ;;
  NightshiftMoveCard)
    # The project is found by its id; the field and the option must be its own.
    local f pid fid oid item
    pid=$(gql_var project) item=$(gql_var item) fid=$(gql_var field) oid=$(gql_var option)
    for f in "$GH_FAKE"/projects/*/project.json; do
      [ -f "$f" ] && [ "$(jq -r .id "$f")" = "$pid" ] || continue
      jq -e --arg f "$fid" --arg o "$oid" '.field.id == $f and any(.field.options[]; .id == $o)' "$f" >/dev/null ||
        { echo "gh: Could not resolve to a ProjectV2SingleSelectField option (fieldId, value)" >&2; exit 1; }
      jq -e --arg i "$item" 'any(.[]; .id == $i)' "$(dirname "$f")/items.json" >/dev/null ||
        { echo "gh: Could not resolve to a ProjectV2Item with the id $item. (itemId)" >&2; exit 1; }
      gh_item_move "$(dirname "$f")" "$item" "$oid"
      jq -n -c --arg i "$item" '{data: {updateProjectV2ItemFieldValue: {projectV2Item: {id: $i}}}}' | out
      return
    done
    echo "gh: Could not resolve to a ProjectV2 with the id $pid. (projectId)" >&2; exit 1 ;;
  *) unexpected ;;
  esac
}

# Project $1 as the board query answers it, on one page: its id, Status field
# and options, and its cards, an issue's read from the fake repo as it is now.
board_page() {
  local d r n issues="{}"
  d=$(gh_project_dir "$1")
  while IFS=' ' read -r r n; do
    [ -f "$(gh_dir "$r")/issues/$n.json" ] &&
      issues=$(jq -c --arg k "$r#$n" --slurpfile i "$(gh_dir "$r")/issues/$n.json" '.[$k] = $i[0]' <<<"$issues")
  done < <(jq -r '.[] | select(.repo) | "\(.repo) \(.number)"' "$d/items.json")
  jq -c --slurpfile items "$d/items.json" --argjson issues "$issues" '
    . as $p | {data: {repositoryOwner: {projectV2: {
      id: .id,
      field: (if .field then {id: .field.id, options: .field.options} else null end),
      items: {pageInfo: {hasNextPage: false, endCursor: null}, nodes: [
        $items[0][] | . as $i
        | (first($p.field.options[] | select(.id == $i.option)) // null) as $o
        | {id: .id,
           fieldValueByName: (if $o then {name: $o.name, optionId: $o.id} else null end),
           content: (if .draft then {__typename: "DraftIssue", id: .draft.id, title: .draft.title}
             else $issues[$i.repo + "#\($i.number)"] as $s
             | if $s then {__typename: "Issue", number: $s.number, updatedAt: $s.updated_at, state: ($s.state | ascii_upcase),
                 repository: {nameWithOwner: $i.repo}, author: {login: $s.user.login}, labels: {nodes: $s.labels}}
               else null end end)}]}}}}}' "$d/project.json"
}

D=""
in_repo() { D=$(gh_dir "$1"); [ -d "$D" ] || not_found; }

api() {
  local path=${POS[1]:-} method r owner name rest n f
  method=$(opt -X || opt --method) || method=GET
  [ "$path" = graphql ] && { graphql; return; }
  [ "$path" = user ] && { jq -n --arg l "$(cat "$GH_FAKE/user")" '{login: $l}' | out; return; }
  owner=$(echo "$path" | cut -d/ -f2) name=$(echo "$path" | cut -d/ -f3)
  r="$owner/$name" rest=${path#repos/"$r"}
  case "$path" in repos/*/*) ;; *) unexpected ;; esac
  in_repo "$r"
  case "$method $rest" in
  "GET ") out <"$D/repo.json" ;;
  "GET /issues?"*)
    case "$rest" in *labels=*) ;; *) unexpected ;; esac
    l=$(echo "$rest" | sed -n 's/.*labels=\([^&]*\).*/\1/p') s=$(echo "$rest" | sed -n 's/.*state=\([^&]*\).*/\1/p')
    for f in "$D"/issues/*.json; do
      case "${f##*/}" in *.*.json) ;; *) cat "$f" ;; esac
    done | jq -s --arg l "$l" --arg s "${s:-open}" 'map(select(.state == $s and any(.labels[]; .name == $l))) | sort_by(.number) | reverse' | etagged ;;
  "GET /issues/"*)
    n=$(echo "$rest" | cut -d/ -f3 | cut -d'?' -f1) f="$D/issues/$n"
    [ -f "$f.json" ] || not_found
    case "$rest" in
    "/issues/$n") out <"$f.json" ;;
    "/issues/$n/labels") jq .labels "$f.json" | out ;;
    "/issues/$n/comments"*) out <"$f.comments.json" ;;
    "/issues/$n/events") out <"$f.events.json" ;;
    *) unexpected ;;
    esac ;;
  "GET /labels/"*) grep -qxF "${rest#/labels/}" "$D/labels" || not_found; jq -n --arg n "${rest#/labels/}" '{name: $n}' | out ;;
  "GET /commits/"*)
    s=$(git -C "$(cat "$D/origin")" rev-parse -q --verify "refs/heads/${rest#/commits/}") || not_found
    jq -n --arg s "$s" '{sha: $s}' | out ;;
  "GET /git/ref/heads/"*)
    s=$(git -C "$(cat "$D/origin")" rev-parse -q --verify "refs/heads/${rest#/git/ref/heads/}") || not_found
    jq -n --arg s "$s" '{object: {sha: $s}}' | out ;;
  "DELETE /git/refs/heads/"*)
    git -C "$(cat "$D/origin")" rev-parse -q --verify "refs/heads/${rest#/git/refs/heads/}" >/dev/null || { echo "gh: Reference does not exist (HTTP 422)" >&2; exit 1; }
    git -C "$(cat "$D/origin")" update-ref -d "refs/heads/${rest#/git/refs/heads/}" ;;
  *) unexpected ;;
  esac
}

# The fields gh pr list/view --json asks for.
fields() { opt --json | jq -R 'split(",")'; }

pr() {
  local state head
  in_repo "$repo"
  case "${POS[1]:-}" in
  list)
    state=$(opt --state) || state=open
    head=$(opt --head) || head=""
    jq --arg s "$(echo "$state" | tr a-z A-Z)" --arg h "$head" --argjson f "$(fields)" --argjson lim "$(opt --limit || echo 30)" '
      map(select(($s == "ALL" or .state == $s) and ($h == "" or .headRefName == $h)))
      | .[:$lim] | map(with_entries(select(.key as $k | $f | index($k))))' "$D/pulls.json" | out ;;
  view)
    jq -e --arg u "${POS[2]}" --argjson f "$(fields)" '
      first(.[] | select(.url == $u or (.number | tostring) == $u)) | with_entries(select(.key as $k | $f | index($k)))' \
      "$D/pulls.json" >/dev/null || not_found
    jq --arg u "${POS[2]}" --argjson f "$(fields)" '
      first(.[] | select(.url == $u or (.number | tostring) == $u)) | with_entries(select(.key as $k | $f | index($k)))' \
      "$D/pulls.json" | out ;;
  create)
    git -C "$(cat "$D/origin")" rev-parse -q --verify "refs/heads/$(opt --head)" >/dev/null ||
      { echo "fake gh: no branch $(opt --head) on the remote" >&2; exit 1; }
    gh_pr "$repo" "$(opt --head)" "$(opt --base || jq -r .default_branch "$D/repo.json")" "$(opt --body || cat "$(opt --body-file)")" ;;
  *) unexpected ;;
  esac
}

issue() {
  local n=${POS[2]:-} f body
  in_repo "$repo"
  f="$D/issues/$n"
  [ -f "$f.json" ] || not_found
  case "${POS[1]:-}" in
  comment)
    body=$(opt --body) || body=$(cat "$(opt --body-file)") || unexpected
    id=$(gh_comment "$repo" "$n" "$(cat "$GH_FAKE/user")" "$body")
    echo "https://github.com/$repo/issues/$n#issuecomment-$id" ;;
  edit)
    if old=$(opt --remove-label); then
      IFS=, read -ra ls <<<"$old"
      for l in "${ls[@]}"; do gh_label_remove "$repo" "$n" "$(cat "$GH_FAKE/user")" "$l"; done
    fi
    new=$(opt --add-label) && gh_label_add "$repo" "$n" "$(cat "$GH_FAKE/user")" "$new"
    echo "https://github.com/$repo/issues/$n" ;;
  *) unexpected ;;
  esac
}

case "${POS[0]:-}" in
"") opt --version >/dev/null && { echo "gh version ${FAKE_GH_VERSION:-2.99.0} (2026-01-01)"; exit 0; }; unexpected ;;
api) api ;;
auth)
  # gh auth status --active: the account and the scopes its token has (see gh_scopes in github.sh).
  [ "${POS[1]:-}" = status ] && opt --active >/dev/null || unexpected
  printf 'github.com\n  \xe2\x9c\x93 Logged in to github.com account %s (keyring)\n  - Active account: true\n  - Token scopes: %s\n' \
    "$(cat "$GH_FAKE/user")" "$(cat "$GH_FAKE/scopes" 2>/dev/null || echo "'gist', 'project', 'read:org', 'repo'")" ;;
pr) pr ;;
issue) issue ;;
label)
  [ "${POS[1]:-}" = create ] || unexpected
  in_repo "$repo"
  grep -qxF "${POS[2]}" "$D/labels" || echo "${POS[2]}" >>"$D/labels" ;;
repo)
  [ "${POS[1]:-}" = view ] || unexpected
  in_repo "${POS[2]}"
  jq '{defaultBranchRef: {name: .default_branch}}' "$D/repo.json" | out ;;
*) unexpected ;;
esac
