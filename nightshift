#!/bin/sh
# nightshift: work GitHub issues labelled `agent` with Claude Code, unattended.
#
#   nightshift watch                     poll the configured repos and run agents
#   nightshift start                     run `watch` in the background, whenever you're logged in
#   nightshift once                      one poll, then exit (for testing)
#   nightshift status                    the service, the issues it knows and what each is doing
#   nightshift stop                      stop the service (until `nightshift start`)
#   nightshift stop <owner/repo>#<n>     stop an issue's running agent
#   nightshift logs [<owner/repo>#<n>] [-f] [-v…]  what every issue (or one) does, at a level
#   nightshift add <owner/repo> <clone>  watch a repo, using this clone of it
#
# State lives in $NIGHTSHIFT_HOME (default ~/.nightshift): `config`, and per
# issue `issues/<owner>_<repo>_<n>/` with `session` (the Claude session id),
# `seen` (the last comment handed to the agent), `pid` while it runs,
# `finished` once a run ended, `pr` once it opened one, `off` (why) while it has
# no label or is closed, `interrupted` if that stopped a run, `after` (the issues
# its open pull request goes after), `update` while an update run waits and
# `updating` while it runs (its status, then why), `conflict` (the default
# branch's commit its pull request was last updated for), `log` (readable,
# live) and `out.jsonl` (the last run's raw stream-json); and per repo,
# `merged/<owner>_<repo>`, the merged nightshift pull requests seen.
set -u

NS="${NIGHTSHIFT_HOME:-$HOME/.nightshift}"
SELF="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
CONFIG="$NS/config"
# The LaunchAgent that runs `nightshift watch` (NIGHTSHIFT_LABEL is for tests).
SERVICE="${NIGHTSHIFT_LABEL:-com.nightshift.watch}"
PLIST="$HOME/Library/LaunchAgents/$SERVICE.plist"
DOMAIN="gui/$(id -u)"
MARKER="<!-- nightshift -->"
LABEL=agent

# A line in watch.log, at the `runs` level (log_at: at another; see LEVELS).
log() { log_at 0 "$*"; }
log_at() { printf '%s\t%s %s\n' "$1" "$(date '+%Y-%m-%d %H:%M:%S')" "$2" >>"$NS/watch.log"; }

# Keep watch.log to its last 20,000 lines once it passes 40,000 (a line per repo
# per poll, and every issue's lines).
trim_log() {
  f="$NS/watch.log"
  [ -f "$f" ] && [ "$(wc -l <"$f")" -gt 40000 ] || return 0
  tail -n 20000 "$f" >"$f.tmp" && mv "$f.tmp" "$f"
}
die() { echo "nightshift: $*" >&2; exit 1; }
usage_error() { echo "$*" >&2; exit 2; }

# A `key=value` setting from the config, or a default.
setting() {
  v=$(sed -n "s/^$1=//p" "$CONFIG" 2>/dev/null | tail -1)
  printf '%s' "${v:-$2}"
}

# `repo <owner/repo> <clone path>` lines.
repos() { sed -n 's/^repo  *\([^ ]*\)  *\(.*\)$/\1 \2/p' "$CONFIG" 2>/dev/null; }

allowed_users() {
  u=$(setting allowed_users "")
  [ -n "$u" ] || u=$(gh api user -q .login)
  printf '%s' "$u"
}

# allowed_users as a jq array literal: ["a","b"].
allowed_json() { printf '["%s"]' "$(allowed_users | sed 's/[ ,][ ,]*/","/g')"; }

issue_dir() { printf '%s/issues/%s_%s' "$NS" "$(echo "$1" | tr '/' '_')" "$2"; }

running() { [ -f "$1/pid" ] && kill -0 "$(cat "$1/pid")" 2>/dev/null; }

# How long ago a file was last modified.
age() { duration $(($(date +%s) - $(date -r "$1" +%s))); }

# Seconds, in their two largest units: 45s, 12m, 2h 5m, 3d 4h.
duration() {
  s=$(($1))
  if [ $s -lt 60 ]; then echo "${s}s"
  elif [ $s -lt 3600 ]; then echo "$((s / 60))m"
  elif [ $s -lt 86400 ]; then echo "$((s / 3600))h $((s % 3600 / 60))m"
  else echo "$((s / 86400))d $((s % 86400 / 3600))h"
  fi
}

count_running() {
  n=0
  for d in "$NS"/issues/*/; do
    [ -d "$d" ] && running "${d%/}" && n=$((n + 1))
  done
  echo $n
}

# --- the service ------------------------------------------------------------------

# The service's pid, if launchd is running it.
service_pid() {
  launchctl print "$DOMAIN/$SERVICE" 2>/dev/null | sed -n 's/^	pid = \([0-9]*\)$/\1/p'
}

service_disabled() {
  launchctl print-disabled "$DOMAIN" 2>/dev/null | grep -Eq "\"$SERVICE\" => (disabled|true)"
}

# The pid of a `nightshift watch` run by hand (not by the service), if one runs.
hand_pid() {
  p=$(cat "$NS/watch.pid" 2>/dev/null)
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null && [ "$p" != "$(service_pid)" ] && printf '%s' "$p"
}

service_line() {
  pid=$(service_pid)
  if [ -n "$pid" ]; then s="running (pid $pid)"
  elif [ -f "$PLIST" ]; then
    s="stopped"
    service_disabled && s="$s (disabled)"
  else s="not installed"
  fi
  h=$(hand_pid) && s="$s · nightshift watch runs by hand (pid $h)"
  echo "service: $s"
}

# The LaunchAgent: this `nightshift watch` whenever you're logged in, with the
# PATH of the shell that ran `start`.
write_plist() {
  mkdir -p "$(dirname "$PLIST")"
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$SERVICE</string>
  <key>ProgramArguments</key>
  <array><string>$SELF</string><string>watch</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$(dirname "$SELF"):$PATH</string>
    <key>NIGHTSHIFT_HOME</key><string>$NS</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ExitTimeOut</key><integer>120</integer>
  <key>StandardOutPath</key><string>$NS/service.log</string>
  <key>StandardErrorPath</key><string>$NS/service.log</string>
</dict>
</plist>
EOF
}

# --- one agent run --------------------------------------------------------------

# The issue's worktree in the repo's clone, created on the first run (or again,
# on its existing branch, after it was removed).
worktree() {
  repo=$1 n=$2 clone=$3
  wt="$clone/.claude/worktrees/issue-$n"
  branch="nightshift/issue-$n"
  if [ ! -d "$wt" ]; then
    git -C "$clone" fetch -q origin >/dev/null 2>&1 || true
    base=$(gh repo view "$repo" --json defaultBranchRef -q .defaultBranchRef.name)
    mkdir -p "$clone/.claude/worktrees"
    # Keep the worktrees out of the clone's own git status (not the repo's .gitignore).
    exclude="$(git -C "$clone" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
    grep -qxF '.claude/worktrees/' "$exclude" 2>/dev/null || echo '.claude/worktrees/' >>"$exclude"
    if git -C "$clone" rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
      git -C "$clone" worktree add -q "$wt" "$branch"
    elif git -C "$clone" rev-parse -q --verify "refs/remotes/origin/$branch" >/dev/null; then
      git -C "$clone" worktree add -q -b "$branch" "$wt" "origin/$branch"
    else
      git -C "$clone" worktree add -q -b "$branch" "$wt" "origin/$base"
    fi
  fi
  printf '%s' "$wt"
}

# Tools a run may use without asking, on top of the permission mode: the ones
# that reach GitHub, which an automatic reviewer might otherwise hold back.
ALLOWED_TOOLS='Bash(gh issue *) Bash(gh pr *) Bash(gh repo view *) Bash(gh api *) Bash(git *) Bash(signalbox *) Bash(boop *)'

# A run's stream-json events, one readable line each, tagged with the level
# `logs` shows it from (a digit and a tab; see LEVELS): the comments it posts,
# the agent's text, tool calls and failed results, then thinking and every
# result. Raw lines (and everything without jq) stay untagged. `run` writes
# them to the issue's log and to watch.log.
RENDER='def line: tostring | gsub("\\s+"; " ") | if length > 300 then .[0:300] + "…" else . end;
  def tag($l): "\($l)\t" + (now | strflocaltime("%Y-%m-%d %H:%M:%S "));
  def stage: (capture("nightshift:(?<s>[a-z]+) -->").s)? // null;
  def text: if type == "array" then map(.text? // "") | join(" ") else . end;
  # The comment stage of a `gh issue comment`: its body, or the file it was written to.
  def comment_stage($files): [stage, ((capture("--body-file[ =]+(?<f>[^ ;&|]+)").f)? as $f | $files[$f])] | map(select(.)) | first;
  def render($files):
    (if .parent_tool_use_id then "  " else "" end) as $in
    | if .type == "system" and .subtype == "init" then tag(2) + "session \(.session_id)"
      elif .type == "assistant" then .message.content[]
        | if .type == "text" then tag(1) + $in + (.text | line)
          elif .type == "thinking" then tag(3) + $in + "… " + (.thinking | line)
          elif .type == "tool_use" then
            (select(.name == "Bash" and (.input.command? // "" | test("gh issue comment")))
              | (.input.command | comment_stage($files)) as $s
              | tag(0) + $in + "commented" + (if $s then " (\($s))" else "" end)),
            tag(2) + $in + "→ \(.name): " + (.input | (.command // .file_path // .pattern // .skill // .url // .query // .description // .prompt // .) | line)
          else empty end
      elif .type == "user" then .message.content[]? | select(.type? == "tool_result")
        | if .is_error == true then tag(2) + $in + "  ✗ " + (.content | text | line)
          else tag(3) + $in + "  ← " + (.content | text | line) end
      elif .type == "result" then tag(if .is_error then 0 else 1 end) + "result (\(.subtype)\(if .is_error then ", error" else "" end)): " + (.result // "" | line)
      else empty end;
  # The stage each written file holds, for comments posted with --body-file.
  foreach inputs as $raw ({files: {}};
    .raw = $raw | .ev = ($raw | try fromjson catch null)
    | .files += ([.ev | objects | select(.type == "assistant") | .message.content[]? | select(.type? == "tool_use") | .input
        | select((.file_path? | type) == "string" and (.content? | type) == "string") | {(.file_path): (.content | stage)}] | add // {});
    .files as $files | if .ev == null then .raw else .ev | render($files) end)'

render() {
  if command -v jq >/dev/null 2>&1; then
    jq -n -R -r --unbuffered "$RENDER"
  else
    cat
  fi
}

# `nightshift _run <repo> <n> <clone>`: one run, as its own process (its pid is
# the issue's `pid`). SIGTERM stops its claude, which runs the SessionEnd hooks.
run_agent() {
  repo=$1 n=$2 clone=$3
  dir=$(issue_dir "$repo" "$n")
  news=$(cat "$dir/news" 2>/dev/null)
  wt=$(worktree "$repo" "$n" "$clone") || { comment_failure "$repo" "$n" "couldn't create the worktree: see $dir/log"; return; }
  echo "$wt" >"$dir/worktree"
  why=$(cat "$dir/interrupted" 2>/dev/null) && rm -f "$dir/interrupted"
  if [ ! -s "$dir/session" ]; then
    intro="This is your first run for this issue."
    resume=""
  else
    intro="New on the issue since your last run:

$news"
    # A run the label's removal (or closing the issue) stopped, now resumed.
    [ -n "$why" ] && intro="Your last run was stopped partway because the $(echo "$why" | sed 's/^label/agent label was/; s/^issue/issue was/'); that's undone now, so carry on from where it stopped.${news:+

$intro}"
    resume="--resume $(cat "$dir/session")"
  fi
  prompt="You are nightshift, working GitHub issue #$n in $repo, unattended: nobody is at a terminal, and you talk to the user only through the issue. Use the issue skill.
This checkout is the issue's own worktree, on branch nightshift/issue-$n.

$intro"
  mode=$(setting permission_mode auto)
  log "$repo#$n: run starting"
  t0=$(date +%s)
  printf '\n0\t=== %s run\n' "$(date '+%Y-%m-%d %H:%M:%S')" >>"$dir/log"
  # The events go to out.jsonl as they come, and readably into the log and,
  # tagged with the issue, into watch.log (closed after each line, which
  # trimming replaces).
  rm -f "$dir/stream" && mkfifo "$dir/stream"
  tee "$dir/out.jsonl" <"$dir/stream" | render | awk -v own="$dir/log" -v all="$NS/watch.log" -v who="$repo#$n:" '
    /^[0-3]\t[0-9-]+ [0-9:]+ / {
      tag = substr($0, 1, 2); day = substr($0, 3, 11); time = substr($0, 14, 9); rest = substr($0, 23)
      print tag time rest >>own; close(own)
      print tag day time who " " rest >>all; close(all)
      next
    }
    { print >>own; close(own) }' &
  rpid=$!
  # shellcheck disable=SC2086 # $resume is two words or none
  (cd "$wt" && exec claude -p "$prompt" --output-format stream-json --verbose --permission-mode "$mode" --allowedTools $ALLOWED_TOOLS $resume </dev/null) >"$dir/stream" 2>>"$dir/log" &
  cpid=$!
  trap 'kill -TERM $cpid 2>/dev/null; stopped=1' TERM INT
  stopped=0
  wait $cpid
  status=$?
  # A signal interrupts `wait`; let claude finish its SessionEnd hooks.
  while kill -0 $cpid 2>/dev/null; do sleep 1; done
  # The renderer ends when the stream closes; something claude left running
  # may hold it open, so give it a few seconds.
  i=0
  while kill -0 $rpid 2>/dev/null && [ $i -lt 5 ]; do sleep 1; i=$((i + 1)); done
  kill $rpid 2>/dev/null
  rm -f "$dir/stream"
  sid=$(sed -n 's/.*"session_id" *: *"\([^"]*\)".*/\1/p' "$dir/out.jsonl" | head -1)
  [ -n "$sid" ] && echo "$sid" >"$dir/session"
  took=$(duration $(($(date +%s) - t0)))
  if [ $stopped -eq 1 ]; then
    run_end "stopped after $took"
    log "$repo#$n: stopped after $took"
    return
  fi
  if [ $status -ne 0 ] || grep '"type" *: *"result"' "$dir/out.jsonl" | grep -q '"is_error" *: *true'; then
    run_end "failed ($status) after $took"
    log "$repo#$n: run failed ($status) after $took"
    comment_failure "$repo" "$n" "$(show_level 3 <"$dir/log" | tail -15)"
  else
    run_end "done in $took"
    log "$repo#$n: run done in $took"
  fi
  # Once there's a pull request, the worktree's work is on GitHub: remove it
  # (the branch stays; a later comment brings it back).
  pr=$(gh pr list --repo "$repo" --head "nightshift/issue-$n" --state all --json url -q '.[0].url' 2>/dev/null)
  if [ -n "$pr" ]; then
    [ "$(cat "$dir/pr" 2>/dev/null)" = "$pr" ] || log "$repo#$n: pull request $pr"
    echo "$pr" >"$dir/pr"
    if [ -z "$(git -C "$wt" status --porcelain 2>/dev/null)" ]; then
      (cd "$wt" && signalbox down --detached-only >/dev/null 2>&1) || true
      git -C "$clone" worktree remove --force "$wt" 2>>"$dir/log" && rm -f "$dir/worktree"
    fi
  fi
}

# The run's last line in its issue log.
run_end() { printf '0\t=== %s run %s\n' "$(date '+%H:%M:%S')" "$1" >>"$dir/log"; }

comment_failure() {
  gh issue comment "$2" --repo "$1" --body "🤖 **nightshift**: the last run failed. Reply to try again.

\`\`\`
$3
\`\`\`
$MARKER" >/dev/null 2>&1 || log "$1#$2: couldn't comment the failure"
}

# --- polling --------------------------------------------------------------------

# The repo's open nightshift pull requests, a line each: the issue, the branch
# it merges into, GitHub's mergeable state, and the issues its body's markers say it goes after and
# overlaps (comma-separated, or -).
open_prs() {
  # shellcheck disable=SC2016 # jq's \(…), not the shell's
  gh pr list --repo "$1" --state open --limit 100 --json headRefName,baseRefName,mergeable,body --jq '
    def marked($m): [.body | scan("<!-- nightshift:\($m) #([0-9]+) -->") | .[0] | tonumber] | unique | map(tostring) | join(",") | if . == "" then "-" else . end;
    .[] | select(.headRefName | startswith("nightshift/issue-"))
    | "\(.headRefName | ltrimstr("nightshift/issue-")) \(.baseRefName) \(.mergeable) \(marked("after")) \(marked("overlaps"))"'
}

# The repo's merged nightshift pull requests, the last 30, a line each: the
# pull request and its issue.
merged_prs() {
  gh pr list --repo "$1" --state merged --limit 30 --json number,headRefName --jq '
    .[] | select(.headRefName | startswith("nightshift/issue-"))
    | "\(.number) \(.headRefName | ltrimstr("nightshift/issue-"))"'
}

# What the open nightshift pull requests say about each other (each issue's
# `after`, for status), and an update run for each labelled one that conflicts
# with its branch now (once per commit of that branch), or goes after or
# overlaps a nightshift pull request that merged since the last poll. The
# merges it has seen are in merged/<owner>_<repo>; the first poll only notes them.
check_prs() {
  repo=$1 open=$2
  prs=$(open_prs "$repo" 2>>"$NS/watch.log") || { log "$repo: couldn't list pull requests"; return; }
  seen="$NS/merged/$(echo "$repo" | tr '/' '_')"
  new=""
  if merged=$(merged_prs "$repo" 2>>"$NS/watch.log"); then
    [ -f "$seen" ] && new=$(printf '%s\n' "$merged" | grep -vxF -f "$seen")
    mkdir -p "$NS/merged"
    printf '%s\n' "$merged" | cat - "$seen" 2>/dev/null | grep . | sort -u >"$seen.tmp"
    mv "$seen.tmp" "$seen"
  else
    log "$repo: couldn't list merged pull requests"
  fi
  rm -f "$NS/issues/$(echo "$repo" | tr '/' '_')"_*/after
  printf '%s\n' "$prs" | while read -r n base mergeable after overlaps; do
    d=$(issue_dir "$repo" "$n")
    [ -n "$n" ] && [ -d "$d" ] || continue
    [ "$after" = - ] || echo "$after" >"$d/after"
    printf '%s\n' "$open" | grep -q "^$n " || continue
    if [ -f "$d/ignored" ] || [ -f "$d/update" ]; then continue; fi
    # A merge it goes after or overlaps: #<issue> (PR #<pr>), and which.
    rel="" how=""
    for pm in $(printf '%s\n' "$new" | tr ' ' :); do
      p=${pm%:*} m=${pm#*:}
      case ",$after," in *",$m,"*) rel="#$m (PR #$p)" how="goes after it"; break ;; esac
      case ",$overlaps," in *",$m,"*) rel="#$m (PR #$p)" how="overlaps it"; break ;; esac
    done
    # A conflict waits for a run in flight; it's still there on the next poll.
    conflicts=0 sha=""
    [ "$mergeable" = CONFLICTING ] && ! running "$d" && conflicts=1
    [ $conflicts -eq 1 ] || [ -n "$rel" ] || continue
    sha=$(gh api "repos/$repo/commits/$base" --jq .sha 2>/dev/null)
    [ -n "$sha" ] && [ "$(cat "$d/conflict" 2>/dev/null)" != "$sha" ] || conflicts=0
    if [ $conflicts -eq 1 ]; then
      echo "$sha" >"$d/conflict"
      queue_update "$repo" "$n" "conflicts, rebasing" \
        "${rel:-$base moved}${rel:+ merged}, and this pull request conflicts with $base now, so I'm rebasing it onto $base and updating it to fit."
    elif [ -n "$rel" ]; then
      # Its update run makes it fit this commit, conflict or not.
      [ -n "$sha" ] && echo "$sha" >"$d/conflict"
      queue_update "$repo" "$n" "updating after ${rel%% *}" \
        "$rel merged, and this pull request $how, so I'm rebasing it onto $base and updating it to fit what merged."
    fi
  done
}

# An update run for an issue's pull request, started by the issue loop: its
# status, and why, which the issue gets as a comment and the run as its news.
queue_update() {
  printf '%s\n%s\n' "$3" "$4" >"$(issue_dir "$1" "$2")/update"
  gh issue comment "$2" --repo "$1" --body "🤖 **nightshift** · progress

$4

$MARKER <!-- nightshift:progress -->" >/dev/null 2>&1 || log "$1#$2: couldn't comment the update"
  log "$1#$2: pull request $3"
}

poll_repo() {
  repo=$1 clone=$2
  allowed=$(allowed_json)
  open=$(gh api "repos/$repo/issues?labels=$LABEL&state=open&per_page=100" \
    --jq '.[] | select(.pull_request | not) | "\(.number) \(.updated_at)"' 2>>"$NS/watch.log") || { log "$repo: couldn't list issues"; return; }

  # Issues no longer labelled (or closed): note which, once, and stop what's
  # running there. Back in the list, the note goes (and a stopped run resumes,
  # below).
  for d in "$NS/issues/$(echo "$repo" | tr '/' '_')"_*; do
    [ -d "$d" ] || continue
    n=${d##*_}
    if printf '%s\n' "$open" | grep -q "^$n "; then
      rm -f "$d/off"
      continue
    fi
    [ -f "$d/off" ] || [ -f "$d/ignored" ] && continue
    state=$(gh api "repos/$repo/issues/$n" --jq .state 2>/dev/null) || continue
    [ "$state" = closed ] && why="issue closed" || why="label removed"
    echo "$why" >"$d/off"
    if running "$d"; then
      echo "$why" >"$d/interrupted"
      kill -TERM "$(cat "$d/pid")" 2>/dev/null
      log "$repo#$n: $why: stopped"
    else
      log "$repo#$n: $why"
    fi
  done

  check_prs "$repo" "$open"

  printf '%s\n' "$open" | {
  count=0 did=""
  while read -r n updated; do
    [ -n "$n" ] || continue
    count=$((count + 1))
    d=$(issue_dir "$repo" "$n")
    running "$d" && { did="$did, #$n running"; continue; }
    [ ! -f "$d/update" ] && [ -f "$d/updated" ] && [ "$(cat "$d/updated")" = "$updated" ] && continue
    if [ ! -d "$d" ]; then
      # Only a label added by an allowed user starts work.
      by=$(gh api --paginate "repos/$repo/issues/$n/events" \
        --jq "[.[] | select(.event == \"labeled\" and .label.name == \"$LABEL\")] | last | .actor.login // empty" 2>/dev/null | tail -1)
      if ! printf '%s' "$allowed" | grep -q "\"$by\""; then
        log "$repo#$n: labelled by ${by:-unknown}, not an allowed user: ignored"
        mkdir -p "$d" && echo "$updated" >"$d/updated" && touch "$d/ignored"
        continue
      fi
      mkdir -p "$d"
    fi
    [ -f "$d/ignored" ] && { echo "$updated" >"$d/updated"; continue; }
    seen=$(cat "$d/seen" 2>/dev/null || echo 0)
    filter=".[] | select(.id > $seen and (.user.login as \$u | $allowed | index(\$u)) and (.body | contains(\"$MARKER\") | not))"
    news=$(gh api --paginate "repos/$repo/issues/$n/comments?per_page=100" \
      --jq "$filter | \"- @\(.user.login) (comment \(.id)):\n\n\(.body[0:3000])\n\"" 2>>"$NS/watch.log")
    last=$(gh api --paginate "repos/$repo/issues/$n/comments?per_page=100" --jq "$filter | .id" 2>/dev/null | tail -1)
    first_run=0
    [ -s "$d/session" ] || [ -f "$d/started" ] || first_run=1
    if [ $first_run -eq 0 ] && [ -z "$news" ] && [ ! -f "$d/interrupted" ] && [ ! -f "$d/update" ]; then
      echo "$updated" >"$d/updated"
      continue
    fi
    if [ "$(count_running)" -ge "$(setting max_parallel 2)" ]; then
      did="$did, #$n waits (at capacity)"
      continue # picked up on a later poll
    fi
    [ -n "$last" ] && echo "$last" >"$d/seen"
    echo "$updated" >"$d/updated"
    touch "$d/started"
    if [ -f "$d/update" ]; then
      mv "$d/update" "$d/updating"
      news="$news${news:+
}- the watcher: $(sed -n 2p "$d/updating")

This is an update run: the issue skill's step for one.
"
    fi
    printf '%s' "$news" >"$d/news"
    "$SELF" _run "$repo" "$n" "$clone" &
    echo $! >"$d/pid"
    did="$did, started #$n"
  done
  [ $count -eq 1 ] && s="" || s="s"
  # Shown by default when it started an issue or one waits; otherwise at `all`.
  case "$did" in *started* | *waits*) l=0 ;; *) l=3 ;; esac
  log_at $l "polled $repo: $count labelled issue$s${did:-, nothing new}"
  # `once` waits for the runs it started (they're children of this pipeline).
  if [ "${NIGHTSHIFT_WAIT:-}" = 1 ]; then wait; fi
  }
}

poll() {
  repos | while read -r repo clone; do
    [ -d "$clone/.git" ] || [ -f "$clone/.git" ] || { log "$repo: $clone isn't a git checkout"; continue; }
    poll_repo "$repo" "$clone"
  done
}

# --- commands -------------------------------------------------------------------

cmd_watch() {
  [ -s "$CONFIG" ] || die "no repos to watch yet: nightshift add <owner/repo> <clone>"
  if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -s "$NS/token" ]; then
    CLAUDE_CODE_OAUTH_TOKEN=$(cat "$NS/token")
    export CLAUDE_CODE_OAUTH_TOKEN
  fi
  echo $$ >"$NS/watch.pid"
  trap stop_watch TERM INT
  log "watching: $(repos | cut -d' ' -f1 | tr '\n' ' ')"
  while :; do
    poll
    trim_log
    sleep "$(setting interval 30)" &
    spid=$!
    wait $spid # a signal interrupts `wait`, not `sleep`
  done
}

# The watcher stopping (the service stopped, a logout, Ctrl-C): stop the runs in
# flight as `nightshift stop <issue>` does, wait for them, and log the issues.
stop_watch() {
  trap '' TERM INT
  kill "${spid:-}" 2>/dev/null
  names=""
  for d in "$NS"/issues/*/; do
    d=${d%/}
    running "$d" || continue
    kill -TERM "$(cat "$d/pid")" 2>/dev/null
    name=$(basename "$d")
    names="$names, $(echo "${name%_*}" | sed 's/_/\//')#${name##*_}"
  done
  for d in "$NS"/issues/*/; do
    while running "${d%/}"; do sleep 1; done
  done
  if [ -n "$names" ]; then log "watch stopped: interrupted ${names#, }"
  else log "watch stopped"
  fi
  rm -f "$NS/watch.pid"
  exit 0
}

cmd_start() {
  pid=$(service_pid)
  [ -n "$pid" ] && { echo "service: already running (pid $pid)"; return; }
  h=$(hand_pid) && die "a nightshift watch already runs by hand (pid $h): stop it first"
  write_plist
  launchctl enable "$DOMAIN/$SERVICE"
  launchctl bootout "$DOMAIN/$SERVICE" 2>/dev/null # loaded but not running
  launchctl bootstrap "$DOMAIN" "$PLIST" || die "launchctl couldn't start $PLIST"
  sleep 1
  service_line
  if [ -s "$CONFIG" ]; then echo "log: nightshift logs -f"
  else echo "no repos to watch yet: nightshift add <owner/repo> <clone> (the service picks it up)"
  fi
}

cmd_status() {
  service_line
  found=0
  for d in "$NS"/issues/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    found=1
    name=$(basename "$d")
    n=${name##*_}
    repo=$(echo "${name%_*}" | sed 's/_/\//')
    if [ -f "$d/ignored" ]; then what="ignored (labelled by someone else)"
    elif running "$d" && [ -f "$d/updating" ]; then what="PR $(cat "$d/pr") · $(head -1 "$d/updating") $(age "$d/pid") (pid $(cat "$d/pid"))"
    elif running "$d"; then what="running $(age "$d/pid") (pid $(cat "$d/pid"))"
    elif [ -f "$d/off" ] && [ -f "$d/interrupted" ]; then what="stopped $(age "$d/off") ago ($(cat "$d/off")) · $(resume_hint "$d")"
    elif [ -f "$d/off" ] && [ -f "$d/pr" ]; then what="PR $(cat "$d/pr") · $(cat "$d/off")"
    elif [ -f "$d/off" ]; then what="$(cat "$d/off") $(age "$d/off") ago"
    elif [ -f "$d/interrupted" ]; then what="queued to resume"
    elif [ -f "$d/update" ]; then what="PR $(cat "$d/pr") · queued: $(head -1 "$d/update")"
    elif [ -f "$d/pr" ]; then what="PR $(cat "$d/pr")$(after_note "$d")$(waited "$d" " · waiting ")"
    elif [ -s "$d/session" ]; then what="waiting for a reply$(waited "$d" " · ")"
    else what="queued"
    fi
    printf '%-40s %s\n' "$repo#$n" "$what"
  done
  [ $found -eq 1 ] || echo "no issues yet"
}

# The issues an open pull request goes after: " · after #10, #11", or nothing.
after_note() {
  [ -s "$1/after" ] && printf ' · after #%s' "$(sed 's/,/, #/g' "$1/after")"
}

# What brings a stopped run back.
resume_hint() {
  if [ "$(cat "$1/off")" = "issue closed" ]; then echo "reopen to resume"
  else echo "add the label back to resume"
  fi
}

# How long an issue has waited since its last run ended, after a prefix; nothing
# if it never ran. Runs from before `finished` was written fall back to `log`.
waited() {
  for f in "$1/finished" "$1/log"; do
    [ -f "$f" ] && { printf '%s%s' "$2" "$(age "$f")"; return; }
  done
}

# `nightshift stop`: the service, until `nightshift start` (across logins).
stop_service() {
  [ -f "$PLIST" ] || die "the service isn't installed"
  launchctl disable "$DOMAIN/$SERVICE"
  pid=$(service_pid)
  [ -n "$pid" ] && echo "stopping the service (and the runs in flight)…"
  launchctl bootout "$DOMAIN/$SERVICE" 2>/dev/null
  if [ -n "$pid" ]; then
    while kill -0 "$pid" 2>/dev/null; do sleep 1; done
  fi
  service_line
}

cmd_stop() {
  [ -n "$1" ] || { stop_service; return; }
  case "$1" in */*#*) ;; *) die "usage: nightshift stop [<owner/repo>#<n>]" ;; esac
  d=$(issue_dir "${1%#*}" "${1##*#}")
  running "$d" || die "$1 isn't running"
  kill -TERM "$(cat "$d/pid")" && echo "stopped $1"
}

# The log levels, each showing the ones before it too: 0 runs (runs and the
# comments posted), 1 messages (the agent's text), 2 tools (tool calls and
# failed results), 3 all (thinking and every result).
LEVELS="runs messages tools all"

# A level's number, from its name or number; nothing if it isn't one.
level_number() {
  i=0
  for l in $LEVELS; do
    [ "$1" = "$l" ] || [ "$1" = $i ] && { echo $i; return; }
    i=$((i + 1))
  done
}

# Log lines (stdin) up to level $1, without their tags. Untagged lines, from
# before levels or not rendered, always show.
show_level() {
  awk -v max="$1" '/^[0-3]\t/ { if (substr($0, 1, 1) + 0 <= max) print substr($0, 3); fflush(); next } { print; fflush() }'
}

logs_help() {
  cat <<'EOF'
usage: nightshift logs [<owner/repo>#<n>] [-f] [-l <level> | -v | -vv | -vvv]

What nightshift does: every issue's lines, each prefixed with its owner/repo#n,
or with <owner/repo>#<n> just that issue's.

  -f                  follow: the last 50 lines, then new ones as they come
  -l, --level <level> show this level and the ones above it (a name, or 0-3):
        runs      (0, the default) issues picked up (or ignored, waiting,
                  stopped), runs started and done with how long they took,
                  each comment nightshift posts and its stage, pull requests
        messages  (1) adds Claude's text
        tools     (2) adds tool calls and failed tool results
        all       (3) adds thinking, every tool result, and the polls with
                  nothing new
  -v, -vv, -vvv       messages, tools, all (they add up: -v -v is -vv)
  -h, --help          this help

Lines logged before levels existed show at every level.
EOF
}

# `logs [<owner/repo>#<n>] [-f] [-l <level> | -v…]`: the whole log, or with -f
# its end, followed, up to a level (default runs).
cmd_logs() {
  f="$NS/watch.log" follow=0 level=0
  usage="usage: nightshift logs [<owner/repo>#<n>] [-f] [-l runs|messages|tools|all | -v | -vv | -vvv]
see nightshift logs --help"
  while [ $# -gt 0 ]; do
    case "$1" in
    -h | --help) logs_help; exit 0 ;;
    -f) follow=1 ;;
    -l | --level) [ $# -ge 2 ] || usage_error "$usage"; level=$(level_number "$2"); shift ;;
    --level=*) level=$(level_number "${1#--level=}") ;;
    -v | -vv | -vvv)
      [ -n "$level" ] || level=0
      level=$((level + ${#1} - 1))
      [ $level -le 3 ] || level=3
      ;;
    */*#*) f="$(issue_dir "${1%#*}" "${1##*#}")/log" ;;
    *) usage_error "$usage" ;;
    esac
    shift
  done
  [ -n "$level" ] || usage_error "$usage"
  [ -d "$(dirname "$f")" ] || die "nightshift doesn't know that issue"
  if [ $follow -eq 1 ]; then
    # The last 50 lines at this level, then what comes after them, as it comes.
    # (-F keeps up when trimming replaces watch.log.)
    c=0
    [ -f "$f" ] && c=$(wc -l <"$f")
    head -n "$c" "$f" 2>/dev/null | show_level "$level" | tail -n 50
    tail -n +$((c + 1)) -F "$f" 2>/dev/null | show_level "$level"
    exit
  fi
  [ -f "$f" ] || die "nothing logged there yet"
  show_level "$level" <"$f"
}

cmd_add() {
  [ $# -eq 2 ] || die "usage: nightshift add <owner/repo> <clone path>"
  clone=$(cd "$2" 2>/dev/null && pwd -P) || die "$2 doesn't exist"
  git -C "$clone" rev-parse --git-dir >/dev/null 2>&1 || die "$clone isn't a git checkout"
  mkdir -p "$NS"
  touch "$CONFIG"
  grep -q "^repo $1 " "$CONFIG" && die "$1 is already watched"
  echo "repo $1 $clone" >>"$CONFIG"
  gh label create "$LABEL" --repo "$1" --color 5319E7 --description "nightshift works this issue" >/dev/null 2>&1 || true
  echo "watching $1 (clone: $clone); add the \`$LABEL\` label to an issue to start"
}

usage() { sed -n '2,11s/^# \{0,1\}//p' "$SELF"; }

mkdir -p "$NS/issues"
case "${1:-}" in
watch) cmd_watch ;;
once) NIGHTSHIFT_WAIT=1; export NIGHTSHIFT_WAIT; poll ;;
_run) shift; run_agent "$@"; rm -f "$(issue_dir "$1" "$2")/pid" "$(issue_dir "$1" "$2")/updating"; touch "$(issue_dir "$1" "$2")/finished" ;;
status) cmd_status ;;
start) cmd_start ;;
stop) shift; cmd_stop "${1:-}" ;;
logs) shift; cmd_logs "$@" ;;
add) shift; cmd_add "$@" ;;
-h | --help | help) usage; echo; echo "nightshift logs --help: the log levels and their flags" ;;
*) usage >&2; exit 2 ;;
esac
